load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# 1. Define the HAL library with recursive header search
cc_library(
    name = "hal",
    srcs = glob(["Drivers/STM32G4xx_HAL_Driver/Src/*.c"]),
    hdrs = glob([
        "Drivers/STM32G4xx_HAL_Driver/Inc/**/*.h", # Recursive search for Legacy/
        "Drivers/CMSIS/Device/ST/STM32G4xx/Include/*.h",
        "Drivers/CMSIS/Include/*.h",
        "Core/Inc/*.h",
    ]),
    includes = [
        "Drivers/STM32G4xx_HAL_Driver/Inc",
        "Drivers/CMSIS/Device/ST/STM32G4xx/Include",
        "Drivers/CMSIS/Include",
        "Core/Inc",
    ],
    defines = ["USE_HAL_DRIVER", "STM32G441xx"],
)

# 2. Define the binary
cc_binary(
    name = "blinky.elf",
    srcs = [
        "Core/Src/main.c",
        "Core/Src/stm32g4xx_hal_msp.c",
        "Core/Src/stm32g4xx_it.c",
        "Core/Src/syscalls.c",
        "Core/Src/sysmem.c",
        "Core/Src/system_stm32g4xx.c",
        "startup_stm32g441xx.s",
    ],
    linkopts = [
        "-T $(location //:STM32G441XX_FLASH.ld)",
        "-Wl,--gc-sections",
        "--specs=nosys.specs",
    ],
    deps = [
        ":hal",
        "//:STM32G441XX_FLASH.ld",
    ],
)

# 3. Flash rule
sh_binary(
    name = "flash",
    srcs = ["flash.sh"],
    data = [":blinky.elf"],
)